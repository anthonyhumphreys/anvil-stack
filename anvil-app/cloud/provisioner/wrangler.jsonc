{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anvil-mesh-provisioner",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
      {
        "name": "ThreadSandbox",
        "class_name": "ThreadSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ThreadSandbox"],
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      // Legacy default-policy app: keep the existing app/class, instance size,
      // and 20-instance cap stable for existing and non-chat environments.
      // Changing scheduling_policy in place is unsupported by Cloudflare.
      "image": "../images/anvil-worker/Dockerfile.cloudflare",
      "instance_type": "standard-1",
      "max_instances": 20,
    },
    {
      "name": "anvil-mesh-provisioner-thread-snapshots",
      "class_name": "ThreadSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          // New namespace for remote chat; legacy environment files cannot
          // be migrated from the default-policy container app.
          "dockerfile": "../images/anvil-worker/Dockerfile.cloudflare",
        },
      },
    },
  ],
  "vars": {
    // BYO deployments (reachable over the internet): set PROVISIONER_TOKEN as
    // a secret (`wrangler secret put PROVISIONER_TOKEN`) and store the same
    // token in the app's provider connection.
    //
    // Managed deployments (bound to the backend via a service binding): keep
    // PROVISIONER_TOKEN set to the same value as the backend's
    // MANAGED_PROVISIONER_TOKEN secret — the binding authenticates with a
    // bearer exactly like the BYO path. ALLOW_UNAUTHENTICATED=true exists
    // only for local dev; never deploy it publicly reachable.
    "ALLOW_UNAUTHENTICATED": "false",
  },
}
