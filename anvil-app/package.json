{
  "name": "anvil",
  "version": "0.1.6",
  "description": "Anvil developer mission control",
  "main": "out/main/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonyhumphreys/anvil-stack.git",
    "directory": "anvil-app"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "predev": "pnpm run rebuild:native:electron",
    "dev": "electron-vite dev",
    "prebuild": "pnpm run rebuild:native:electron",
    "build": "electron-vite build",
    "dist:mac:arm64": "node scripts/dist.mjs --mac dmg zip --arm64 --publish never --brand=anvil",
    "dist:mac:arm64:anvil": "node scripts/dist.mjs --mac dmg zip --arm64 --publish never --brand=anvil",
    "dist:mac:arm64:anvil:notarized": "bash scripts/build-macos-arm64-anvil-notarized.sh",
    "preview": "electron-vite preview",
    "pretest": "pnpm run rebuild:native:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "postinstall": "pnpm run rebuild:native:node",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3,node-pty",
    "rebuild:native:node": "pnpm rebuild better-sqlite3 node-pty"
  },
  "keywords": [
    "electron",
    "react",
    "developer-tools",
    "developer-tools"
  ],
  "author": "Anthony Humphreys",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anvilstack/cloud-cli": "^0.1.1",
    "@anvilstack/registry-cli": "^0.1.1",
    "@shikijs/langs": "^4.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "abort-controller": "^3.0.0",
    "ansi-regex": "^6.2.2",
    "balanced-match": "^1.0.2",
    "better-sqlite3": "^12.6.2",
    "dompurify": "^3.4.11",
    "events-universal": "^1.0.1",
    "globby": "^16.2.0",
    "lru-cache": "^11.2.7",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.15.0",
    "ms": "^2.1.3",
    "node-pty": "^1.1.0",
    "openai": "^6.44.0",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "simple-git": "^3.36.0",
    "text-decoder": "^1.2.7",
    "typescript": "^5.9.3",
    "wrappy": "^1.0.2",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion@1": "1.1.14",
      "brace-expansion@2": "2.0.3",
      "brace-expansion@5": "5.0.6",
      "flatted": "3.4.2",
      "ip-address": "10.1.1",
      "lodash": "4.18.0",
      "lodash-es": "4.18.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "@babel/core": "7.29.6",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.2.0",
      "postcss": "8.5.14",
      "shell-quote": "1.8.4",
      "tar": "7.5.16",
      "tmp": "0.2.7",
      "uuid@11": "11.1.1",
      "uuid@7": "11.1.1",
      "vite": "7.3.5",
      "ws": "8.21.0",
      "yaml@1": "1.10.3"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
