NEXT_PUBLIC_ANVIL_APP_REPO_URL=
NEXT_PUBLIC_ANVIL_REGISTRY_REPO_URL=

# WorkOS AuthKit — required for the /account area and sign-in.
# When unset the site builds and runs without auth; /account renders a
# not-configured panel instead of crashing.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# At least 32 characters. `openssl rand -base64 24` works.
WORKOS_COOKIE_PASSWORD=
# Must match the redirect URI configured in the WorkOS dashboard.
# The SDK reads NEXT_PUBLIC_WORKOS_REDIRECT_URI as WORKOS_REDIRECT_URI.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# Hosted sync service channel — the signed channel to the backend's
# /internal/hosted/* API (anvil-app/cloud/backend). All three are required;
# when unset, account pages degrade to a not-configured panel.
ANVIL_BACKEND_ORIGIN=
# Key id: ^[A-Za-z0-9_-]{1,64}$
ANVIL_HOSTED_KEY_ID=
# At least 32 bytes; must match the backend's HOSTED_SERVICE_KEYS entry.
ANVIL_HOSTED_SERVICE_SECRET=

# Optional price display on /pricing. Paid plans are unavailable until
# 1 Nov 2026 regardless; these only control the rendered price strings.
NEXT_PUBLIC_SYNC_PRICE_MONTHLY=
NEXT_PUBLIC_SYNC_PRICE_ANNUAL=
NEXT_PUBLIC_SYNC_PRICE_CURRENCY=
