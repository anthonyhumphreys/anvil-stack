# Anvil service environment is separate from NODE_ENV and Vercel's deployment
# slot. Unset defaults to staging for existing local and staging deployments.
ANVIL_DEPLOYMENT_ENV=staging

NEXT_PUBLIC_ANVIL_APP_REPO_URL=
NEXT_PUBLIC_ANVIL_REGISTRY_REPO_URL=
NEXT_PUBLIC_ANVIL_CLOUD_REPO_URL=

# Staging WorkOS AuthKit — isolated from production users and configuration.
ANVIL_STAGING_WORKOS_API_KEY=
ANVIL_STAGING_WORKOS_CLIENT_ID=
# At least 32 characters; `openssl rand -base64 24` works.
ANVIL_STAGING_WORKOS_COOKIE_PASSWORD=
# Must match the callback URI registered in the staging WorkOS environment.
ANVIL_STAGING_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Staging hosted sync channel — credentials and origin for the staging backend.
ANVIL_STAGING_BACKEND_ORIGIN=
ANVIL_STAGING_HOSTED_KEY_ID=
# At least 32 bytes; must match the staging backend's HOSTED_SERVICE_KEYS entry.
ANVIL_STAGING_HOSTED_SERVICE_SECRET=

# Production values are required when ANVIL_DEPLOYMENT_ENV=production.
# Production never falls back to staging values or the legacy unscoped names.
ANVIL_PRODUCTION_WORKOS_API_KEY=
ANVIL_PRODUCTION_WORKOS_CLIENT_ID=
ANVIL_PRODUCTION_WORKOS_COOKIE_PASSWORD=
ANVIL_PRODUCTION_WORKOS_REDIRECT_URI=https://anvil.dev/auth/callback
ANVIL_PRODUCTION_BACKEND_ORIGIN=
ANVIL_PRODUCTION_HOSTED_KEY_ID=
ANVIL_PRODUCTION_HOSTED_SERVICE_SECRET=

# Existing unscoped values are accepted as staging fallbacks for compatibility:
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_COOKIE_PASSWORD=
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# ANVIL_BACKEND_ORIGIN=
# ANVIL_HOSTED_KEY_ID=
# ANVIL_HOSTED_SERVICE_SECRET=

# Optional price display on /pricing. Paid plans are unavailable until
# 1 Nov 2026 regardless; these only control the rendered price strings.
NEXT_PUBLIC_SYNC_PRICE_MONTHLY=
NEXT_PUBLIC_SYNC_PRICE_ANNUAL=
NEXT_PUBLIC_SYNC_PRICE_CURRENCY=
