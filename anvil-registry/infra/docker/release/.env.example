# Copy this file to .env before starting Anvil Registry.
# The release bundle fails closed when required values are missing.

# Pin this to the Registry release you downloaded.
ANVIL_REGISTRY_VERSION=registry-v0.1.6
ANVIL_REGISTRY_IMAGE_PREFIX=ghcr.io/anthonyhumphreys/anvil-stack

# The URL npm and pnpm clients use. Tarball URLs are rewritten to this value.
# Use HTTPS through a reverse proxy when the Registry is reachable beyond a trusted LAN.
PUBLIC_BASE_URL=http://192.168.1.134:4873

# Use 127.0.0.1 when a reverse proxy runs on the Docker host. Use 0.0.0.0 for a LAN-only pilot.
ANVIL_BIND_ADDRESS=0.0.0.0
ANVIL_GATEWAY_PORT=4873
ANVIL_ADMIN_PORT=3000

# Start in development mode while seeding and reviewing policy decisions.
# Move to ci or production only after representative lockfiles have been warmed and reviewed.
RUNTIME_MODE=development

# Store all durable state beneath this directory. Back it up before upgrades.
ANVIL_DATA_DIR=./data

# Generate unique values before starting the stack, for example with: openssl rand -hex 32
ANVIL_ADMIN_TOKEN=replace-with-a-random-admin-token
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
MINIO_ROOT_USER=anvil-minio
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password

# Public npm is the default upstream. Configure private/scoped upstreams with JSON when needed.
UPSTREAM_NPM_REGISTRY=https://registry.npmjs.org
UPSTREAM_NPM_REGISTRIES_JSON=

# Optional image overrides for operators that pin infrastructure images by digest.
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
MINIO_IMAGE=minio/minio
MINIO_MC_IMAGE=minio/mc

# Optional policy overrides.
POLICY_MINIMUM_PACKAGE_AGE_DAYS=3
POLICY_HIDE_QUARANTINED_METADATA=false

# Optional LLM review. Deterministic policy remains the enforcement authority.
LLM_REVIEW_ENABLED=false
LLM_REVIEW_PROVIDER=
LLM_REVIEW_MODEL=
LLM_REVIEW_ENDPOINT=
LLM_REVIEW_API_KEY=
LLM_REVIEW_RUN_ON_UNKNOWN_PACKAGES=false
LLM_REVIEW_RUN_ON_QUARANTINE=false
LLM_REVIEW_INCLUDE_PRIVATE_PACKAGES=false

# Optional Codex CLI provider. Used only with docker-compose.codex.yml.
# Mount the file, never the whole ~/.codex directory.
CODEX_AUTH_FILE=/home/your-user/.codex/auth.json
CODEX_CLI_TIMEOUT_MS=120000
