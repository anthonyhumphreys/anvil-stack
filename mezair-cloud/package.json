{
  "name": "mezair-cloud",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Agent-ready apps on AWS, without giving agents AWS.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @mezairstack/cloud-cli dev",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "mezair-cloud": "node packages/cli/dist/index.js",
    "verify:notes-golden-path": "node scripts/verify-notes-local.mjs",
    "verify:notes-local": "pnpm verify:notes-golden-path",
    "verify:aws-preview": "node scripts/verify-aws-preview.mjs",
    "verify:application-backends": "node scripts/verify-application-backends.mjs",
    "preflight:application-backends": "node scripts/preflight-application-backends.mjs",
    "test:preflight:application-backends": "node --test scripts/preflight-application-backends.test.mjs",
    "verify:cloudflare-preview": "pnpm build && node scripts/verify-cloudflare-preview.mjs",
    "verify:mesh-rehearsal": "node scripts/verify-mesh-rehearsal.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.12",
      "esbuild": "0.28.1",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.26",
      "sharp": "0.35.5",
      "undici@7": "7.30.1",
      "source-map-js": "1.2.2",
      "zod@4": "4.6.7"
    }
  }
}
