{
  "name": "anvil-cloud",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Agent-ready apps on AWS, without giving agents AWS.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @anvil-cloud/cli dev",
    "lint": "pnpm -r lint",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "anvil": "node packages/cli/dist/index.js",
    "verify:notes-local": "node scripts/verify-notes-local.mjs",
    "verify:aws-preview": "node scripts/verify-aws-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
