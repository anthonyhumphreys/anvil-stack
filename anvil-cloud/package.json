{
  "name": "anvil-cloud",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "Agent-ready apps on AWS, without giving agents AWS.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @anvilstack/cloud-cli dev",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "anvil-cloud": "node packages/cli/dist/index.js",
    "verify:notes-golden-path": "node scripts/verify-notes-local.mjs",
    "verify:notes-local": "pnpm verify:notes-golden-path",
    "verify:aws-preview": "node scripts/verify-aws-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.9",
      "esbuild": "0.28.1",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.26"
    }
  }
}
