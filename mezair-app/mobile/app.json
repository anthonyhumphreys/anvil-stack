{
  "expo": {
    "name": "Mezair Companion",
    "slug": "mezair-companion",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mezair-companion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.anthonyhumphreys.mezair.app.companion",
      "appleTeamId": "43W273J2TJ",
      "buildNumber": "3",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect securely to your Mezair hosts on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.anthonyhumphreys.mezair.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#f8f7f4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withMezairMeshNetworking",
      "./plugins/withMezairCompanionSurfaces",
      "./plugins/withMezairDriveModeCarPlay",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mezair Companion to scan pairing QR codes from your Mac."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#171717",
          "dark": {
            "backgroundColor": "#171717"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
