{
  "name": "mezair-mesh-provisioner",
  "version": "0.1.0",
  "private": true,
  "description": "ENV-04/ENV-09: Cloudflare Sandbox provisioner bridge for mezair-worker environments (BYO cloudflare-sandbox and the mezair-managed service-binding backend)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.13.0-next.751.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.135.0"
  },
  "pnpm": {
    "overrides": {
      "vite@8": "8.3.5",
      "undici@7": "7.30.1",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5",
      "zod@4": "4.6.7",
      "hono": "4.13.11"
    }
  }
}
