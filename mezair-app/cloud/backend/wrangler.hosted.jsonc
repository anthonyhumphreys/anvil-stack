{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mezair-backend-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // BILL-01 hosted deployment: same Worker + Durable Objects + R2 surface as
  // wrangler.jsonc, plus the D1 billing store used by hosted identity
  // and the /internal/hosted/* service channel. Self-host deploys keep using
  // wrangler.jsonc and never provision D1.
  //
  // HOSTED_SERVICE_KEYS is a `wrangler secret put` value — a JSON map of
  // {"keyId":"secret"} for the website -> backend HMAC channel. Never a var.
  //
  // Deploy this template through `mezair-cloud mesh --mode hosted`.
  // The CLI provisions D1/R2, applies migrations and installs secrets.
  // See docs/runbooks/hosted-sync/deploy.md in mezair-app for the complete
  // branch-testing sequence and per-target generated configuration.
  //
  // Hosted identity and billing. Stripe is optional during code-only beta.
  // Secrets via `wrangler secret put`, never in vars:
  //   WORKOS_API_KEY          WorkOS environment key for org + invite APIs
  //   WORKOS_WEBHOOK_SECRET   signing secret for /v1/hosted/workos-webhook
  //   HOSTED_SERVICE_KEYS     website -> backend HMAC map (BILL-01)
  //   HOSTED_OPERATOR_KEYS    separate operator-only HMAC map (optional)
  // Vars:
  //   HOSTED_CHECKOUT_ENABLED       false during beta; explicit true opens paid signup
  //   HOSTED_PORTAL_RETURN_URL      fixed portal return target for existing billing
  //   HOSTED_BILLING_ENVIRONMENT    generated as 'staging' or 'production'
  //   HOSTED_ADMITTED_WORKOS_USER_IDS JSON array of reviewed existing user_... IDs, if needed
  //   STRIPE_API_BASE               test-only override; forbidden in production
  //   HOSTED_SYNC_LIMITS            JSON partial override of default quotas
  //
  // HOSTED_BILLING_ENFORCEMENT gates hosted writes on paid or redeemed beta access.
  //
  // ENV-09: MANAGED_PROVISIONER binds the mezair-mesh-provisioner worker
  // (cloud/provisioner) so `mezair-managed` environments run on Mezair-operated
  // Cloudflare Sandbox capacity. Absence fails closed — job.create rejects
  // managed provisions with provider-unavailable. Secrets:
  //   MANAGED_PROVISIONER_TOKEN   bearer sent on the service-binding channel
  // Vars:
  //   MEZAIR_PUBLIC_API_URL        public backend URL injected into env bootstrap
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT",
        "class_name": "AccountCoordinator",
      },
      {
        "name": "SESSIONS",
        "class_name": "SessionCoordinator",
      },
      {
        "name": "MACHINE_ENDPOINTS",
        "class_name": "MachineEndpointCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountCoordinator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionCoordinator"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MachineEndpointCoordinator"],
    },
  ],
  // BILL-06: hourly reconcile + metrics sweep. Off-the-hour to avoid the
  // top-of-hour cron pile-up; per-account staleness and batch limits are
  // in src/hosted/reconciler.ts.
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "mezair-spike-artifacts",
    },
  ],
  // ENV-09: the managed provisioner is a separate worker (cloud/provisioner)
  // reached over a service binding — uncomment once it is deployed in the
  // same account, and `wrangler secret put MANAGED_PROVISIONER_TOKEN`.
  // "services": [
  //   {
  //     "binding": "MANAGED_PROVISIONER",
  //     "service": "mezair-mesh-provisioner",
  //   },
  // ],
  "d1_databases": [
    {
      "binding": "HOSTED_DB",
      "database_name": "mezair-hosted-billing",
      "database_id": "<placeholder-not-created>",
      "migrations_dir": "migrations/hosted-billing",
    },
  ],
  "vars": {
    // See wrangler.jsonc for OIDC_* / ENROLLMENT_ADMIN_TOKEN notes. The dev
    // spike flag stays absent here exactly as it does in the self-host
    // config — production must fail closed.
    // BILL-03: mutating-work enforcement is on for hosted deployments.
    "HOSTED_BILLING_ENFORCEMENT": "true",
    // Mezair-operated Cloud Agents compute is a future opt-in; keep it off.
    "HOSTED_CHECKOUT_ENABLED": "false",
    "MEZAIR_CLOUD_AGENTS_ENABLED": "false",
    // Provider pricing and capacity confirmation are required before this can be enabled.
    "MEZAIR_MESH_MANAGED_ENDPOINTS": "false",
  },
}
