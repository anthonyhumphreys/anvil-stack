{
  "name": "mezair-registry",
  "version": "0.1.7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @mezairstack/persistence db:migrate",
    "dev:gateway": "pnpm --filter @mezairstack/registry dev",
    "dev:worker": "pnpm --filter @mezairstack/worker dev",
    "lint": "turbo run lint",
    "smoke:analysis": "./scripts/smoke-analysis-queue",
    "smoke:clients": "./scripts/smoke-npm-clients",
    "smoke:llm-review": "./scripts/smoke-llm-review",
    "smoke:local": "MEZAIR_REGISTRY_URL=http://localhost:4873 MEZAIR_ADMIN_URL=http://localhost:3000 pnpm --filter @mezairstack/registry-cli dev -- smoke",
    "smoke:node-base-image": "./scripts/smoke-node-base-image",
    "smoke:node-base-image-observed": "./scripts/smoke-node-base-image-observed",
    "smoke:node-base-image-report": "./scripts/smoke-node-base-image-report",
    "smoke:node-base-report": "./scripts/smoke-node-base-report",
    "smoke:scoped-upstream": "tsx scripts/smoke-scoped-upstream.ts",
    "release:compose:check": "node scripts/validate-release-compose.mjs",
    "sst:preflight": "pnpm --dir infra/sst deploy:preflight",
    "sst:migrate": "pnpm --dir infra/sst sst shell -- pnpm --filter @mezairstack/infra-sst migrate:run",
    "test:node-base": "./devcontainer-base/scripts/test-node-base-scripts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:smokes": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --skipLibCheck scripts/smoke-scoped-upstream.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "fast-uri": "3.1.9",
      "find-my-way": "9.7.0",
      "postcss": "8.5.26",
      "sharp": "0.35.5",
      "vite": "7.3.7",
      "source-map-js": "1.2.2",
      "postcss-selector-parser@6": "6.1.5",
      "zod@4": "4.6.7"
    }
  }
}
