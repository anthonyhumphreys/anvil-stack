#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE_TAG="${MEZAIR_NODE_BASE_SMOKE_IMAGE:-mezair-node-base-smoke:local}"

if [[ -n "${MEZAIR_NODE_BASE_SMOKE_IMAGE:-}" ]] && docker image inspect "$IMAGE_TAG" >/dev/null 2>&1; then
  echo "[mezair] Reusing existing Node Base image ($IMAGE_TAG)"
else
  echo "[mezair] Building Node Base image ($IMAGE_TAG)"
  docker build -t "$IMAGE_TAG" -f "$ROOT_DIR/devcontainer-base/Dockerfile" "$ROOT_DIR/devcontainer-base"
fi

echo "[mezair] Verifying Node Base image defaults"
docker run --rm "$IMAGE_TAG" bash -lc '
set -euo pipefail

test "$(id -un)" = "node"
test "${MEZAIR_SECURITY_MODE:-}" = "safe"
test "${MEZAIR_REPORT_DIR:-}" = "/workspaces/.mezair/reports"
test "${NPM_CONFIG_FOREGROUND_SCRIPTS:-}" = "true"
test "$(npm config get ignore-scripts)" = "true"
test "$(npm config get foreground-scripts)" = "true"
test "$(npm config get fund)" = "false"
test "$(npm config get audit)" = "true"
test "$(npm config get save-exact)" = "true"
test -d /workspaces/.mezair/reports
test -w /workspaces/.mezair/reports

for command in jq rg lsof strace python3; do
  command -v "$command" >/dev/null
done

for command in \
  mezair-npm-ci-safe \
  mezair-npm-ci-observed \
  mezair-dep-report \
  mezair-scan-lifecycle-scripts \
  mezair-scan-install-logs \
  mezair-network-monitor \
  mezair-risk-gate \
  mezair-use-registry \
  mezair-submit-report \
  mezair-submit-report-if-configured
do
  command -v "$command" >/dev/null
done
'

echo "[mezair] Node Base image smoke passed."
